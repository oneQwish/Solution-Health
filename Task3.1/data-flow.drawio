<mxfile host="app.diagrams.net"><diagram name="Поток данных: результат анализа из LIS в мобильное приложение" id="data-flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1018" pageHeight="1430"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n_start" value="Результат готов в LIS" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="196" y="30" width="193" height="36" as="geometry"/></mxCell><mxCell id="n_s1" value="LIS выгружает файл результата (XML)&lt;br&gt;в каталог выгрузки на своём сервере" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="178" y="117" width="228" height="36" as="geometry"/></mxCell><mxCell id="n_s2" value="Агент выгрузки записывает файл в хранилище&lt;br&gt;под ключом «исследование + версия»,&lt;br&gt;только если ключа ещё нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="153" y="204" width="279" height="47" as="geometry"/></mxCell><mxCell id="n_d1" value="Запись принята&lt;br&gt;хранилищем?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F2C94C;strokeColor=none;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="359" y="302" width="222" height="72" as="geometry"/></mxCell><mxCell id="n_dh" value="Хеш совпадает&lt;br&gt;с сохранённым?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F2C94C;strokeColor=none;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="377" y="434" width="222" height="72" as="geometry"/></mxCell><mxCell id="n_rep" value="Повтор того же файла:&lt;br&gt;файл считается доставленным" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="261" y="572" width="192" height="36" as="geometry"/></mxCell><mxCell id="n_a2" value="Под той же версией другое содержимое:&lt;br&gt;оповещение владельца LIS,&lt;br&gt;исправление приходит новой версией" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="566" width="243" height="47" as="geometry"/></mxCell><mxCell id="n_r1" value="Повтор загрузки: 10 с, 30 с, 1 мин,&lt;br&gt;далее раз в 5 мин" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="135" y="452" width="205" height="36" as="geometry"/></mxCell><mxCell id="n_a1" value="Нет записи 30 минут: оповещение&lt;br&gt;дежурных, файл остаётся в каталоге" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="572" width="225" height="36" as="geometry"/></mxCell><mxCell id="n_del" value="Агент удаляет файл из каталога выгрузки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="355" y="682" width="253" height="36" as="geometry"/></mxCell><mxCell id="n_s3" value="Хранилище отправляет событие&lt;br&gt;о новом файле в брокер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="763" y="452" width="200" height="36" as="geometry"/></mxCell><mxCell id="n_s4" value="Сервис анализов читает файл,&lt;br&gt;проверяет хеш и схему XML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="769" y="572" width="189" height="36" as="geometry"/></mxCell><mxCell id="n_d2" value="Файл&lt;br&gt;корректен?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F2C94C;strokeColor=none;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="669" y="664" width="174" height="72" as="geometry"/></mxCell><mxCell id="n_q1" value="Карантин файла, оповещение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="664" y="814" width="186" height="36" as="geometry"/></mxCell><mxCell id="n_d3" value="Версия новее&lt;br&gt;сохранённой?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F2C94C;strokeColor=none;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="427" y="796" width="200" height="72" as="geometry"/></mxCell><mxCell id="n_x1" value="Дубль или устаревшая версия:&lt;br&gt;отбросить, подтвердить сообщение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="649" y="934" width="217" height="36" as="geometry"/></mxCell><mxCell id="n_s5" value="Сохранение результата, прежняя версия&lt;br&gt;помечается «заменена»; запись&lt;br&gt;в outbox в той же транзакции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="368" y="928" width="244" height="47" as="geometry"/></mxCell><mxCell id="n_f1" value="Сбой обработки: сообщение возвращается&lt;br&gt;в очередь, после 5 попыток в DLQ&lt;br&gt;и оповещение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="724" y="1035" width="252" height="47" as="geometry"/></mxCell><mxCell id="n_s6" value="Публикация события «результат готов»&lt;br&gt;(идентификатор, версия, ссылка на файл)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="366" y="1040" width="250" height="36" as="geometry"/></mxCell><mxCell id="n_s7a" value="CRM обновляет карточку пациента&lt;br&gt;(идемпотентный получатель)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="268" y="1133" width="213" height="36" as="geometry"/></mxCell><mxCell id="n_endc" value="Результат в карточке пациента" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="1220" width="271" height="36" as="geometry"/></mxCell><mxCell id="n_s7b" value="Уведомления отправляют&lt;br&gt;push / SMS «результат готов»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="527" y="1133" width="181" height="36" as="geometry"/></mxCell><mxCell id="n_s8" value="Пациент открывает приложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="527" y="1220" width="201" height="36" as="geometry"/></mxCell><mxCell id="n_s9" value="API Gateway запрашивает результат&lt;br&gt;у сервиса анализов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="518" y="1307" width="219" height="36" as="geometry"/></mxCell><mxCell id="n_end" value="Результат отображается в приложении" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=none;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="463" y="1394" width="329" height="36" as="geometry"/></mxCell><mxCell id="edge_0" value="" style="endArrow=block;html=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;curved=1;" edge="1" parent="1" source="n_start" target="n_s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_1" value="" style="endArrow=block;html=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;curved=1;" edge="1" parent="1" source="n_s1" target="n_s2">